<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:myGame="clr-namespace:MyGame"
        x:Class="MyGame.MainWindow"
        Title="MonoGame + Avalonia"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen">

    <!-- A single MonoGameControl fills the entire window.
         The Game instance is created in code-behind and assigned via SetGame().
         See https://github.com/thundergames/thunder-monogame-avalonia/tree/main/docs/how-to
         for a full walkthrough, including the XAML namespace, both wiring patterns,
         and required project flags (AllowUnsafeBlocks, BuiltInComInteropSupport). -->
    <Grid RowDefinitions="*,Auto,*">
        <myGame:MonoGameControl x:Name="Host" />
        <GridSplitter Grid.Row="1"></GridSplitter>
        <TextBox Grid.Row="2" Text="This is a TextBox below the MonoGameControl." />
    </Grid>

</Window>
